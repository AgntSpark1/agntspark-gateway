AGNTSPARK_GATEWAY_DATABASE_URL=postgresql+asyncpg://agntspark:agntspark@localhost:5432/agntspark_gateway
AGNTSPARK_GATEWAY_JWT_SECRET=change-me-in-production
AGNTSPARK_GATEWAY_JWT_ALGORITHM=HS256
AGNTSPARK_GATEWAY_JWT_EXPIRE_MINUTES=60
AGNTSPARK_GATEWAY_CORS_ALLOW_ORIGINS=["http://localhost:5173"]
AGNTSPARK_GATEWAY_LOG_LEVEL=INFO
AGNTSPARK_GATEWAY_ENVIRONMENT=development

# Agent Runtime / Control Plane
AGNTSPARK_GATEWAY_DOCKER_SOCKET=unix:///var/run/docker.sock
AGNTSPARK_GATEWAY_DOCKER_IMAGE=agntspark/agent-runtime:latest
AGNTSPARK_GATEWAY_DOCKER_NETWORK=agntspark-net
AGNTSPARK_GATEWAY_SCHEDULER_INTERVAL_SECONDS=30
# Generate a real one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGNTSPARK_GATEWAY_SECRET_ENCRYPTION_KEY=change-me-in-production

# Data layer / rate limiting
AGNTSPARK_GATEWAY_REDIS_URL=redis://localhost:6379/0
AGNTSPARK_GATEWAY_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
AGNTSPARK_GATEWAY_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
