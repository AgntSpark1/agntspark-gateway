{$API_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Prometheus exposition is for internal scraping only — it leaks container
	# IDs and platform-wide counts, so never serve it publicly.
	@internal path /metrics /metrics/*
	respond @internal 404

	handle /v1/* {
		reverse_proxy gateway:8080
	}

	handle /healthz {
		reverse_proxy gateway:8080
	}

	# Console SPA, same origin as the API (its default base URL is /v1).
	handle {
		root * /srv/console
		try_files {path} /index.html
		file_server
	}
}
