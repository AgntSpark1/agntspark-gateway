[Unit]
Description=Stop agent containers from reaching each other on the agnt-agents bridge
After=docker.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Containers on one bridge talk at layer 2, which only passes through iptables
# once br_netfilter is loaded and bridge-nf-call-iptables is on. Without these
# two steps the rules below silently match nothing.
ExecStartPre=/sbin/modprobe br_netfilter
ExecStartPre=/sbin/sysctl -q -w net.bridge.bridge-nf-call-iptables=1
# Packets between two containers on the agents bridge are dropped unless one
# side is Caddy (10.89.0.2, pinned in docker-compose.prod.yml), so tenants can
# only reach each other through their public URLs. RETURN hands allowed
# packets back to Docker's own forwarding rules. Each rule is inserted at the
# top only if missing, in an order that keeps the RETURNs above the DROP.
ExecStart=/bin/sh -c 'iptables -C DOCKER-USER -i agnt-agents -o agnt-agents -j DROP 2>/dev/null || iptables -I DOCKER-USER -i agnt-agents -o agnt-agents -j DROP'
ExecStart=/bin/sh -c 'iptables -C DOCKER-USER -i agnt-agents -o agnt-agents -d 10.89.0.2 -j RETURN 2>/dev/null || iptables -I DOCKER-USER -i agnt-agents -o agnt-agents -d 10.89.0.2 -j RETURN'
ExecStart=/bin/sh -c 'iptables -C DOCKER-USER -i agnt-agents -o agnt-agents -s 10.89.0.2 -j RETURN 2>/dev/null || iptables -I DOCKER-USER -i agnt-agents -o agnt-agents -s 10.89.0.2 -j RETURN'

[Install]
WantedBy=docker.service
